@model WebApplicationPokemon.Models.Gym

@{
    ViewData["Title"] = "Modifica Palestra";
}

<h2 class="text-white mb-4">Modifica Palestra</h2>

<form asp-action="Edit" method="post" class="text-white">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Citta" class="form-label"></label>
        <input asp-for="Citta" class="form-control" />
        <span asp-validation-for="Citta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning rounded-pill">Salva</button>
    <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Annulla</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
