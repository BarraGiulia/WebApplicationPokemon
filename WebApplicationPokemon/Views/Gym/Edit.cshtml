@model WebApplicationPokemon.Models.Gym
@{
    ViewData["Title"] = "Edit Gym";
}

<h2>Edit Gym</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input asp-for="Citta" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Trainers</label>
        <input asp-for="Trainers" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-warning">Update</button>
</form>
