@model WebApplicationPokemon.Models.Gym

@{
    ViewData["Title"] = "Aggiungi Palestra";
}

<h2 class="text-white mb-4">Aggiungi Palestra</h2>

<form asp-action="Create" method="post" class="text-white">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Citta" class="form-label"></label>
        <input asp-for="Citta" class="form-control" />
        <span asp-validation-for="Citta" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TipoPalestra" class="form-label">Tipo di Palestra</label>
        <select asp-for="TipoPalestra" class="form-select">
            <option value="">-- Seleziona Tipo --</option>
            <option>Fuoco</option>
            <option>Acqua</option>
            <option>Erba</option>
            <option>Elettro</option>
            <option>Roccia</option>
            <option>Psico</option>
            <option>Drago</option>
            <option>Buio</option>
        </select>
        <span asp-validation-for="TipoPalestra" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-success rounded-pill">Salva</button>
    <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Annulla</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
