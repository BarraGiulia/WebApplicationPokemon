@model WebApplicationPokemon.Models.Gym
@{
    ViewData["Title"] = "Add Gym";
}

<h2>Add Gym</h2>

<form asp-action="Add" method="post">
    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input asp-for="Citta" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Trainers</label>
        <input asp-for="Trainers" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
</form>
