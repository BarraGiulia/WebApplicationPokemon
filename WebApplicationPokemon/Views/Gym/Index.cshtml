@model List<WebApplicationPokemon.Models.Gym>

@{
    ViewData["Title"] = "Palestre Pokémon";
}

<div class="container py-5">
    <h2 class="text-white fw-bold mb-4 text-center">Palestre Pokémon</h2>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-success rounded-pill fw-semibold" href="@Url.Action("Create", "Gym")">Aggiungi Palestra</a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var gym in Model)
            {
                <div class="col-md-4">
                    <div class="card bg-dark text-white border-light shadow rounded-4">
                        <div class="card-body">
                            <h5 class="card-title text-warning">@gym.Nome</h5>
                            <p><strong>Città:</strong> @gym.Citta</p>
                            

                            <div class="d-flex gap-2 mt-3">
                                <a class="btn btn-primary rounded-pill" href="@Url.Action("Details", "Gym", new { id = gym.Id })">Dettagli</a>
                                <a class="btn btn-warning rounded-pill" href="@Url.Action("Edit", "Gym", new { id = gym.Id })">Modifica</a>
                                <a class="btn btn-danger rounded-pill" href="@Url.Action("Delete", "Gym", new { id = gym.Id })">Elimina</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center rounded-pill fw-semibold mt-5">
            Nessuna palestra trovata con il termine cercato.
        </div>
    }
</div>
