@model List<WebApplicationPokemon.Models.Gym>
@{
    ViewData["Title"] = "Pokémon Gyms";
}

<div class="container py-5">
    <h2 class="text-white fw-bold mb-4 text-center">Pokémon Gyms</h2>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-success rounded-pill fw-semibold" href="/Gym/Add">Add Gym</a>
    </div>

    <div class="row g-4">
        @foreach (var gym in Model)
        {
            <div class="col-md-4">
                <div class="card bg-dark text-white border-light shadow rounded-4">
                    <div class="card-body">
                        <h5 class="card-title text-warning">@gym.Nome</h5>
                        <p><strong>City:</strong> @gym.Citta</p>
                        <p><strong>Trainers:</strong> @gym.Trainers</p>

                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-primary rounded-pill" href="/Gym/Details/@gym.Id">Details</a>
                            <a class="btn btn-warning rounded-pill" href="/Gym/Edit/@gym.Id">Edit</a>
                            <a class="btn btn-danger rounded-pill" href="/Gym/Delete/@gym.Id">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
