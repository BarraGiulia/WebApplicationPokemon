@model WebApplicationPokemon.Models.Trainer

@{
    ViewData["Title"] = "Conferma eliminazione";
}

<h2>Sei sicuro di voler eliminare @Model.Nome?</h2>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit">Conferma eliminazione</button>
    <a asp-action="Index">Annulla</a>
</form>
