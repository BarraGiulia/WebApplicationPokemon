@model WebApplicationPokemon.Models.Trainer
@{
    ViewData["Title"] = "Modifica Allenatore";
}

<div class="container text-white">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label for="NumeroPokemons">Numero di Pokémon</label>
            <input type="number" class="form-control" name="NumeroPokemons" value="@Model.Pokemons?.Count" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Età</label>
            <input asp-for="Eta" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Città</label>
            <input asp-for="Citta" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Salva</button>
        <a asp-action="Index" class="btn btn-secondary">Annulla</a>
    </form>
</div>
