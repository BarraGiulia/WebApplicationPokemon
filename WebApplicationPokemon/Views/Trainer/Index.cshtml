@model List<WebApplicationPokemon.Models.Trainer>
@{
    ViewData["Title"] = "Allenatori Pokémon";
}

<div class="container py-5">
    <h2 class="text-white fw-bold mb-4 text-center">Allenatori Pokémon</h2>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-success rounded-pill fw-semibold" asp-action="Create">Aggiungi Allenatore</a>
    </div>

    <div class="row g-4">
        @foreach (var trainer in Model)
        {
            <div class="col-md-4">
                <div class="card bg-dark text-white border-light shadow rounded-4">
                    <div class="card-body">
                        <h5 class="card-title text-info">@trainer.Nome</h5>
                        <p><strong>Età:</strong> @trainer.Eta</p>
                        <p><strong>Città:</strong> @trainer.Citta</p>
                        <p><strong>Palestra:</strong> @trainer.Gym?.Nome</p>
                        <p><strong>Pokémon:</strong> @trainer.Pokemons?.Count</p>

                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-primary rounded-pill" asp-action="Details" asp-route-id="@trainer.Id">Dettagli</a>
                            <a class="btn btn-warning rounded-pill" asp-action="Edit" asp-route-id="@trainer.Id">Modifica</a>
                            <a class="btn btn-danger rounded-pill" asp-action="Delete" asp-route-id="@trainer.Id">Elimina</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
