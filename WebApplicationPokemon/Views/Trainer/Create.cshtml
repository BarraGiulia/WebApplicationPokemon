@model WebApplicationPokemon.Models.Trainer
@{
    ViewData["Title"] = "Aggiungi Allenatore";
}

<div class="container text-white">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" />
            <div class="mb-3">
                <label for="NumeroPokemons">Numero di Pokémon</label>
                <input type="number" class="form-control" name="NumeroPokemons" />
            </div>

        </div>
        <div class="mb-3">
            <label class="form-label">Età</label>
            <input asp-for="Eta" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Città</label>
            <input asp-for="Citta" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success">Salva</button>
        <a asp-action="Index" class="btn btn-secondary">Annulla</a>
    </form>
</div>
