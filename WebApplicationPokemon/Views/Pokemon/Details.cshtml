@model WebApplicationPokemon.Models.Pokemon

@{
    ViewData["Title"] = "Dettagli Pokémon";
}

<div class="container py-5 text-white">
    <h2 class="text-center mb-4">Dettagli Pokémon</h2>

    <div class="card bg-dark border-light shadow rounded-4 p-4">
        <h3>@Model.Nome</h3>
        <p><strong>Tipo:</strong> @Model.Tipo</p>
        <p><strong>Livello:</strong> @Model.Livello</p>
        <p><strong>Allenatore:</strong> @Model.Trainer?.Nome</p>

        <div class="mt-4">
            <a class="btn btn-secondary rounded-pill" href="/Pokemon">Torna indietro</a>
        </div>
    </div>
</div>
