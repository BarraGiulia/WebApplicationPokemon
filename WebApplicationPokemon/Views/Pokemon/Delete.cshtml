@model WebApplicationPokemon.Models.Pokemon

@{
    ViewData["Title"] = "Elimina Pokémon";
}

<div class="container py-5 text-white">
    <h2 class="text-center mb-4">Conferma eliminazione</h2>

    <div class="card bg-dark p-4 shadow">
        <h4>Sei sicuro di voler eliminare <strong>@Model.Nome</strong>?</h4>
        <p>Tipo: @Model.Tipo</p>
        <p>Allenatore: @Model.Trainer?.Nome</p>

        <form method="post" asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger rounded-pill">Elimina</button>
            <a href="/Pokemon" class="btn btn-secondary rounded-pill ms-2">Annulla</a>
        </form>
    </div>
</div>
