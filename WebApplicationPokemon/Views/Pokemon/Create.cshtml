@model WebApplicationPokemon.Models.Pokemon

@{
    ViewData["Title"] = "Aggiungi Pokémon";
}

<div class="container py-5 text-white">
    <h2 class="text-center mb-4">Aggiungi Pokémon</h2>

    <form method="post" class="bg-dark p-4 rounded shadow">
        <div class="mb-3">
            <label>Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Tipo" class="form-label">Tipo</label>
            <select asp-for="Tipo" class="form-select">
                <option value="">-- Seleziona Tipo --</option>
                <option>Fuoco</option>
                <option>Acqua</option>
                <option>Erba</option>
                <option>Elettro</option>
                <option>Ghiaccio</option>
                <option>Lotta</option>
                <option>Roccia</option>
                <option>Veleno</option>
                <option>Terra</option>
                <option>Volante</option>
                <option>Psico</option>
                <option>Coleottero</option>
                <option>Spettro</option>
                <option>Acciaio</option>
                <option>Folletto</option>
                <option>Drago</option>
                <option>Buio</option>
                <option>Normale</option>
            </select>
            <span asp-validation-for="Tipo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Livello</label>
            <input asp-for="Livello" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Allenatore</label>
            <input asp-for="Trainer.Nome" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success rounded-pill">Salva</button>
        <a href="/Pokemon" class="btn btn-secondary rounded-pill ms-2">Annulla</a>
    </form>
</div>
